[Desktop Entry]
Type=Service

Name=G-TMCE Extract
Name[tr]=G-TMCE Extract

Comment=Extract tracks, subtitles, chapters and attachments from media files
Comment[tr]=Medya dosyalarından parça, altyazı, chapter ve ek çıkar

ServiceTypes=KonqPopupMenu/Plugin
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel

MimeType=video/*;audio/matroska;audio/x-matroska;audio/ogg;application/ogg;application/x-matroska;application/vnd.ms-asf;application/vnd.rn-realmedia;

Icon=g-tmce

Actions=OpenMkvCreatorExtract;

[Desktop Action OpenMkvCreatorExtract]
Name=Open with G-TMCE Extract
Name[tr]=G-TMCE Extract ile Aç

Icon=g-tmce
Exec=g-tmce --extract %f
